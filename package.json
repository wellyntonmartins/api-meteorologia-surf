{
  "name": "api-meteorologia-surf",
  "version": "1.0.0",
  "description": "Typescript NodeJs Api",
  "keywords": [
    "nodejs",
    "typescript",
    "api"
  ],
  "homepage": "https://github.com/wellyntonmartins/api-meteorologia-surf#readme",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/wellyntonmartins/api-meteorologia-surf/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wellyntonmartins/api-meteorologia-surf.git"
  },
  "license": "ISC",
  "author": "Wellynton Martins",
  "main": "dist/src/server.js",
  "scripts": {
    "build": "tsoa routes && tsc",
    "start": "node dist/src/server.js",
    "dev": "tsx watch src/server.ts",
    "start:dev": "tsx watch src/server.ts",
    "typecheck": "tsoa routes && tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "jest",
    "test:functional": "jest --projects ./test --runInBand",
    "test:unit": "jest",
    "style:check": "prettier --check src/**/*.ts test/**/*.ts",
    "style:fix": "prettier --write src/**/*.ts test/**/*.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/module-alias": "^2.0.4",
    "@types/node": "^26.6.2",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "cross-env": "^10.1.0",
    "eslint": "^10.11.0",
    "express": "^5.2.1",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "jiti": "^2.7.0",
    "module-alias": "^2.3.4",
    "prettier": "^3.9.9",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "tsoa": "^7.0.0-alpha.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.1"
  },
  "dependencies": {
    "axios": "^1.20.0"
  }
}
